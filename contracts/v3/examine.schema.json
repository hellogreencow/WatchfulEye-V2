{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "contracts/v3/examine.schema.json",
  "title": "POST /api/v3/examine (WS0 contract scaffold)",
  "type": "object",
  "required": ["request", "response"],
  "properties": {
    "request": {
      "type": "object",
      "additionalProperties": false,
      "required": ["q"],
      "properties": {
        "q": { "type": "string", "minLength": 1 },
        "k": { "type": "integer", "minimum": 1, "maximum": 50, "default": 10 },
        "types": {
          "type": "array",
          "items": { "type": "string", "enum": ["ticker", "country", "sanctions_target"] },
          "default": ["ticker", "country", "sanctions_target"]
        }
      }
    },
    "response": {
      "type": "object",
      "additionalProperties": false,
      "required": ["investigation_id", "report_id", "status", "trace_id", "report"],
      "properties": {
        "investigation_id": { "type": "string", "minLength": 1 },
        "report_id": { "type": "string", "minLength": 1 },
        "status": { "type": "string", "enum": ["queued", "running", "succeeded", "failed"] },
        "trace_id": { "type": "string", "minLength": 1 },
        "report": {
          "type": "object",
          "additionalProperties": false,
          "required": ["title", "summary", "content"],
          "properties": {
            "title": { "type": "string" },
            "summary": { "type": "string" },
            "content": { "type": ["object", "null"] }
          }
        }
      }
    }
  }
}


