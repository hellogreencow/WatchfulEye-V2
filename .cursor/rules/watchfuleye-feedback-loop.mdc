## WS6.1: Forecast Accountability (Implementation Plan)

### Core Components

#### 1. Forecast Storage Schema

**Postgres Table: `forecasts`**
```sql
CREATE TABLE forecasts (
  id TEXT PRIMARY KEY,
  report_id TEXT NOT NULL REFERENCES v3_reports(id),
  investigation_id TEXT REFERENCES v3_investigations(id),

  -- Forecast content
  claim TEXT NOT NULL,
  probability REAL NOT NULL CHECK (probability >= 0.0 AND probability <= 1.0),
  horizon_days INTEGER NOT NULL,
  horizon_date TIMESTAMPTZ NOT NULL,

  -- Entity linking
  entity_ids TEXT[],
  entity_types TEXT[],

  -- Evidence
  evidence_ids TEXT[],
  assumptions TEXT[],

  -- Outcome tracking
  outcome_status TEXT NOT NULL DEFAULT 'pending', -- pending|resolved|inconclusive|invalid
  outcome_result BOOLEAN, -- true=happened, false=didn't happen, null=pending/inconclusive
  outcome_confidence REAL, -- 0.0-1.0, assessor confidence in outcome determination
  outcome_measured_at TIMESTAMPTZ,
  outcome_method TEXT, -- 'market_data'|'event_feed'|'manual'|'composite'
  outcome_evidence JSONB,

  -- Scoring
  brier_score REAL, -- (forecast_prob - actual_outcome)^2
  log_score REAL, -- log(prob) if happened, log(1-prob) if didn't
  calibration_bin INTEGER, -- 0-10 (0-10%, 10-20%, ..., 90-100%)

  -- Metadata
  created_at TIMESTAMPTZ NOT NULL DEFAULT now(),
  updated_at TIMESTAMPTZ NOT NULL DEFAULT now(),
  created_by TEXT, -- user_id or 'system'
  tags TEXT[]
);

CREATE INDEX idx_forecasts_report_id ON forecasts(report_id);
CREATE INDEX idx_forecasts_horizon_date ON forecasts(horizon_date);
CREATE INDEX idx_forecasts_outcome_status ON forecasts(outcome_status);
CREATE INDEX idx_forecasts_entity_ids ON forecasts USING GIN(entity_ids);
CREATE INDEX idx_forecasts_tags ON forecasts USING GIN(tags);
```

**Postgres Table: `forecast_updates`** (audit trail)
```sql
CREATE TABLE forecast_updates (
  id BIGSERIAL PRIMARY KEY,
  forecast_id TEXT NOT NULL REFERENCES forecasts(id),
  update_type TEXT NOT NULL, -- 'outcome_resolved'|'confidence_updated'|'invalidated'
  previous_state JSONB,
  new_state JSONB,
  reason TEXT,
  updated_by TEXT, -- user_id or 'system'
  updated_at TIMESTAMPTZ NOT NULL DEFAULT now()
);
