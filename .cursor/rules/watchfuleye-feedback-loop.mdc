#### 2. Forecast Extraction (From Reports)

**Backend: `watchfuleye/v3/forecast/extractor.py`**
```python
from typing import List, Dict, Any
from datetime import datetime, timedelta

def extract_forecasts_from_report(
    report_id: str,
    report_content: Dict[str, Any],
    investigation_id: str | None = None
) -> List[Dict[str, Any]]:
    """
    Extract structured forecasts from report content.

    Looks for:
    - "predictions" section
    - probability claims (explicit or inferred)
    - time horizons (explicit or inferred from context)
    """
    forecasts = []

    predictions = report_content.get("predictions", [])
    for pred in predictions:
        # Parse prediction text for probability and horizon
        # Example: "70% chance Iran increases oil exports within 30 days"
        probability = extract_probability(pred)
        horizon_days = extract_horizon(pred)
        claim = normalize_claim(pred)

        if probability and horizon_days:
            forecasts.append({
                "report_id": report_id,
                "investigation_id": investigation_id,
                "claim": claim,
                "probability": probability,
                "horizon_days": horizon_days,
                "horizon_date": datetime.utcnow() + timedelta(days=horizon_days),
                "evidence_ids": report_content.get("evidence_ids", []),
                "assumptions": report_content.get("assumptions", []),
            })

    return forecasts
```

#### 3. Outcome Measurement (Automated)

**Backend: `watchfuleye/v3/forecast/outcome_tracker.py`**
```python
from typing import Literal

OutcomeMethod = Literal["market_data", "event_feed", "manual", "composite"]

async def measure_forecast_outcome(forecast_id: str) -> Dict[str, Any]:
    """
    Measure forecast outcome using multiple methods.

    Priority order:
    1. Market data (if forecast is about price movements)
    2. Event feeds (ACLED, GDELT, official announcements)
    3. Manual assessment (if automated methods fail)
    4. Composite (combine multiple signals with confidence weighting)
    """
    forecast = get_forecast(forecast_id)

    # Determine outcome method based on forecast type
    if is_market_forecast(forecast):
        return await measure_via_market_data(forecast)
    elif is_event_forecast(forecast):
        return await measure_via_event_feeds(forecast)
    else:
        return {"outcome_status": "pending", "outcome_method": "manual"}

async def measure_via_market_data(forecast: Dict[str, Any]) -> Dict[str, Any]:
    """
    Measure outcomes for market-related forecasts.

    Example: "80% chance AAPL closes above $180 by Jan 31"
    """
    entity_ids = forecast["entity_ids"]
    horizon_date = forecast["horizon_date"]

    # Fetch price data from WS5 markets connector
    prices = await fetch_market_data(entity_ids, horizon_date)

    # Evaluate claim against actual data
    outcome_result = evaluate_market_claim(forecast["claim"], prices)

    return {
        "outcome_status": "resolved",
        "outcome_result": outcome_result,
        "outcome_confidence": 1.0,  # Market data is authoritative
        "outcome_method": "market_data",
        "outcome_measured_at": datetime.utcnow(),
        "outcome_evidence": {"prices": prices}
    }

async def measure_via_event_feeds(forecast: Dict[str, Any]) -> Dict[str, Any]:
    """
    Measure outcomes for event-based forecasts.

    Example: "60% chance of conflict escalation in Gaza within 14 days"
    """
    claim = forecast["claim"]
    horizon_date = forecast["horizon_date"]
    entity_ids = forecast["entity_ids"]

    # Fetch events from WS5 connectors (ACLED, GDELT, news)
    events = await fetch_event_data(entity_ids, horizon_date)

    # Evaluate claim against events (may require LLM for nuanced assessment)
    outcome_result, confidence = evaluate_event_claim(claim, events)

    return {
        "outcome_status": "resolved" if confidence > 0.7 else "inconclusive",
        "outcome_result": outcome_result if confidence > 0.7 else None,
        "outcome_confidence": confidence,
        "outcome_method": "event_feed",
        "outcome_measured_at": datetime.utcnow(),
        "outcome_evidence": {"events": events}
    }
```

#### 4. Accuracy Scoring

**Backend: `watchfuleye/v3/forecast/scorer.py`**
```python
def calculate_brier_score(probability: float, outcome: bool) -> float:
    """
    Brier score: (p - actual)^2

    Perfect prediction: 0.0
    Worst prediction: 1.0
    """
    actual = 1.0 if outcome else 0.0
    return (probability - actual) ** 2

def calculate_log_score(probability: float, outcome: bool) -> float:
    """
    Logarithmic score (proper scoring rule).

    Penalizes confident wrong predictions heavily.
    """
    import math
    epsilon = 1e-10  # Prevent log(0)

    if outcome:
        return math.log(max(probability, epsilon))
    else:
        return math.log(max(1 - probability, epsilon))

def assign_calibration_bin(probability: float) -> int:
    """
    Assign probability to calibration bin (0-10).

    Bin 0: 0-10%
    Bin 1: 10-20%
    ...
    Bin 9: 90-100%
    """
    return min(int(probability * 10), 9)

def calculate_calibration_curve(forecasts: List[Dict[str, Any]]) -> Dict[int, Dict[str, float]]:
    """
    Calculate calibration curve across all bins.

    Perfect calibration: forecasts at 70% should happen 70% of the time.
    """
    bins = {i: {"count": 0, "successes": 0} for i in range(10)}

    for f in forecasts:
        if f["outcome_status"] != "resolved":
            continue

        bin_idx = assign_calibration_bin(f["probability"])
        bins[bin_idx]["count"] += 1
        if f["outcome_result"]:
            bins[bin_idx]["successes"] += 1

    # Calculate observed frequency per bin
    calibration = {}
    for bin_idx, data in bins.items():
        if data["count"] > 0:
            observed_freq = data["successes"] / data["count"]
            expected_freq = (bin_idx + 0.5) / 10  # Mid-point of bin
            calibration[bin_idx] = {
                "expected": expected_freq,
                "observed": observed_freq,
                "count": data["count"],
                "error": abs(observed_freq - expected_freq)
            }

    return calibration
```

